{
  "name": "dshw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dshw": "src/cli.ts"
  },
  "exports": {
    ".": "./plugin/lib/index.cjs",
    "./client": {
      "types": "./plugin/lib/client.d.ts",
      "default": "./plugin/lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build:plugin": "node scripts/build-plugin.mjs",
    "check": "pnpm run typecheck && pnpm run build:plugin && pnpm test",
    "check:plugin": "tsc -p plugin/tsconfig.json --noEmit",
    "dshw": "node src/cli.ts",
    "dev:kernel": "DSHW_DEV_MODE=1 DSHW_PORT=7851 DSHW_DATA_ROOT=.dshw/dev node --watch --watch-preserve-output src/cli.ts daemon",
    "dev:test": "node --test --watch tests/*.test.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "^6.0.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@dreamcatcher-tech/commit-graph": "2.2.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vue": "^3.5.41"
  }
}
